{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmitOnError": false,
    "downlevelIteration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/server/**/*", "src/index.ts"]
}
